FINNHUB_API_KEY=your_finnhub_api_key
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=sp500.trades
KAFKA_CONSUMER_GROUP=sp500-consumer
GICS_SECTOR=Information Technology
